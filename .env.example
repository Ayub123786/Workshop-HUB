# =================================================================
# WORKSHOP HUB — ENVIRONMENT CONFIGURATION (SUPABASE)
# =================================================================

# Server Port
PORT=5000

# Supabase Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication
JWT_SECRET=workshop-hub-production-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Cloudinary Storage (optional for image manager; fallback placeholders provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (optional for notifications; logged to console if unconfigured)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Workshop Hub <noreply@workshophub.com>
ADMIN_EMAIL=admin@workshophub.com

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
SEED_ADMIN_EMAIL=admin@workshophub.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Admin User

# Client Environment (Vite)
VITE_API_URL=http://localhost:5000/api
