PORT=5000

# Supabase Database Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Cloudinary (optional - images will use placeholder URLs if not set)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (Nodemailer - use Gmail app password or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=Workshop Hub <your-email@gmail.com>
ADMIN_EMAIL=admin@example.com

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Seed credentials
SEED_ADMIN_EMAIL=admin@workshophub.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Admin User
