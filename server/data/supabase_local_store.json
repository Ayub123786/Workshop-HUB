    {
      "workshop_id": "dadb10de-1c78-4f0a-9f43-4a69d91f08e6",
      "type": "stages",
      "order": 5,
      "visible": true,
      "content": {
        "label": "WHAT YOU'LL BUILD",
        "heading": "8 Stages. Live Results.",
        "subtitle": "Each stage collapses days of analyst work into minutes using AI — and you leave with every prompt ready to paste tomorrow.",
        "items": [
          {
            "id": "s1",
            "number": "01",
            "icon": "TrendingUp",
            "title": "Deal Origination",
            "description": "Auto-generate a daily target watchlist of acquisition candidates scored against your fund mandate — replacing 3–5 hours of manual scanning with a 10-minute automated report.",
            "duration": "10 min",
            "timeSaved": "3–5 hrs saved"
          },
          {
            "id": "s2",
            "number": "02",
            "icon": "FileSearch",
            "title": "CIM Screening",
            "description": "Run a 100-point, 10-dimension scorecard on any CIM in 8 minutes — producing a pass/proceed recommendation before your morning call.",
            "duration": "8 min",
            "timeSaved": "Hours saved"
          },
          {
            "id": "s3",
            "number": "03",
            "icon": "BarChart2",
            "title": "Commercial Due Diligence",
            "description": "Generate a full market research report with TAM, competitive landscape, and timing thesis — with cited sources — in 3 hours instead of 2 weeks.",
            "duration": "3 hrs",
            "timeSaved": "2 weeks → 3 hrs"
          },
          {
            "id": "s4",
            "number": "04",
            "icon": "DollarSign",
            "title": "Financial Due Diligence",
            "description": "Normalise EBITDA, review LBO model assumptions, and produce a plain-language model summary for partners — in 2 hours instead of 5 days.",
            "duration": "2 hrs",
            "timeSaved": "5 days → 2 hrs"
          },
          {
            "id": "s5",
            "number": "05",
            "icon": "Users",
            "title": "Management Due Diligence",
            "description": "Run systematic background checks on entire leadership teams — with red flag triggers and risk ratings — in 45 minutes.",
            "duration": "45 min",
            "timeSaved": "Days → 45 min"
          },
          {
            "id": "s6",
            "number": "06",
            "icon": "Scale",
            "title": "Legal DD & SPA Review",
            "description": "Scan legal documents and SPAs for red flags, non-market terms, and negotiation points — in 20 minutes before your lawyers open a single page.",
            "duration": "20 min",
            "timeSaved": "Before lawyers open a page"
          },
          {
            "id": "s7",
            "number": "07",
            "icon": "FileText",
            "title": "IC Memo",
            "description": "Assemble an 80% complete 20–35 page Investment Committee memo from all prior DD outputs — in 30 minutes instead of 20 hours.",
            "duration": "30 min",
            "timeSaved": "20 hrs → 30 min"
          },
          {
            "id": "s8",
            "number": "08",
            "icon": "Shield",
            "title": "Portfolio Monitoring",
            "description": "Auto-generate monthly KPI reports across every portfolio company the day financials arrive — and compile quarterly LP letters in 30 minutes.",
            "duration": "30 min",
            "timeSaved": "Monthly auto-reports"
          }
        ]
      },
